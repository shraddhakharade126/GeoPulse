# Copy this file to .env and fill in your account details.
# Prefer browser SSO; do not put a password in this file.
SNOWFLAKE_ACCOUNT=your-account-identifier
SNOWFLAKE_USER=your-login-name
SNOWFLAKE_AUTHENTICATOR=externalbrowser
SNOWFLAKE_ROLE=SYSADMIN
SNOWFLAKE_WAREHOUSE=GEOPULSE_WH
SNOWFLAKE_DATABASE=GEOPULSE_DB
SNOWFLAKE_SCHEMA=RAW
# SNOWFLAKE_PASSWORD=only-use-for-approved-password-authentication
